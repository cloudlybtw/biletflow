# Copy to .env and adjust as needed. Never commit the real .env.

# Postgres
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=biletflow
POSTGRES_DB=biletflow
POSTGRES_PORT=5432

# Backend — these defaults target the local `uv run` dev loop (outside
# Docker), talking to db/mailpit via their published localhost ports. The
# `api` service in docker-compose.yml overrides DATABASE_URL/SMTP_HOST to the
# container-internal hostnames (db/mailpit) itself.
DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5432/biletflow
JWT_SECRET=change-me-in-dev-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFY_TOKEN_HOURS=24
EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_MINUTES=60
PASSWORD_RESET_COOLDOWN_SECONDS=60
WEB_BASE_URL=http://localhost:5173

# Mailpit (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@biletflow.local

# Published ports
API_PORT=8000
MAILPIT_WEB_PORT=8025

# Template only. Configure real values privately in the chosen host's secret store.
ENVIRONMENT=production
PORT=8000
# postgres:// and postgresql:// provider URLs are normalized to asyncpg.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST/biletflow
DATABASE_SSL_MODE=verify-full
# Set if the provider uses a private CA; keep certificate verification enabled.
# DATABASE_SSL_CA_FILE=/run/secrets/database-ca.pem
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEB_BASE_URL=https://REPLACE_FRONTEND_HOST
CORS_ORIGINS=["https://REPLACE_FRONTEND_HOST"]
MEDIA_ROOT=/var/data/media
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_SECRET
SMTP_FROM=REPLACE_VERIFIED_SENDER
SMTP_TIMEOUT_SECONDS=10

FROM migrate/migrate:v4.17.1 AS migration
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.4 /uv /usr/local/bin/uv
COPY --from=migration /usr/local/bin/migrate /usr/local/bin/migrate
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY app ./app
COPY migrations ./migrations
RUN useradd --create-home --uid 10001 biletflow && mkdir -p /var/data/media && chown -R biletflow:biletflow /app /var/data
USER biletflow
ENV PATH="/app/.venv/bin:$PATH"
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
